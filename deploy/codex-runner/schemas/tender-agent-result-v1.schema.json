{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitatech.local/schemas/tender-agent-result-v1.schema.json",
  "title": "Tender agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_catalog_version",
    "field_catalog_sha256",
    "input_manifest_sha256",
    "inspection_coverage",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "tender_agent_result_v1"
    },
    "field_catalog_version": {
      "const": "tender_fields_v1"
    },
    "field_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inspection_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inspectionCoverage"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableNonBlankString": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonBlankString"
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldKey": {
      "type": "string",
      "enum": [
        "procurement_subject",
        "nm_price_with_vat",
        "platform",
        "procedure_type",
        "application_deadline",
        "application_review_date",
        "results_date",
        "customer",
        "customer_contacts",
        "participation_cost",
        "participation_guarantee",
        "evaluation_criteria",
        "delivery_term",
        "payment_terms",
        "special_account_or_treasury",
        "bank_support",
        "government_contract",
        "rebidding",
        "national_regime",
        "advance_contract_guarantee",
        "warranty_obligations_guarantee",
        "licenses_certificates",
        "required_official_certificates",
        "similar_supply_experience",
        "analog_allowed",
        "analog_definition",
        "application_documents"
      ]
    },
    "inspectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "source_file",
        "inspection_status",
        "methods",
        "expected_pages",
        "inspected_pages",
        "notes"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "source_file": {
          "$ref": "#/$defs/nonBlankString"
        },
        "inspection_status": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "unreadable"
          ]
        },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text_layer",
              "rendered_pages",
              "ooxml",
              "controls",
              "sheets"
            ]
          }
        },
        "expected_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inspected_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pageLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "page_to",
        "section",
        "structural_element",
        "sheet",
        "cell_range"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pdf_page",
            "docx_page"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_to": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "structural_element": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "sheet": {
          "type": "null"
        },
        "cell_range": {
          "type": "null"
        }
      }
    },
    "docxOoxmlLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "page_to",
        "section",
        "structural_element",
        "sheet",
        "cell_range"
      ],
      "properties": {
        "kind": {
          "const": "docx_ooxml"
        },
        "page": {
          "type": "null"
        },
        "page_to": {
          "type": "null"
        },
        "section": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "structural_element": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "sheet": {
          "type": "null"
        },
        "cell_range": {
          "type": "null"
        }
      },
      "anyOf": [
        {
          "properties": {
            "section": {
              "$ref": "#/$defs/nonBlankString"
            }
          }
        },
        {
          "properties": {
            "structural_element": {
              "$ref": "#/$defs/nonBlankString"
            }
          }
        }
      ]
    },
    "xlsxCellLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "page_to",
        "section",
        "structural_element",
        "sheet",
        "cell_range"
      ],
      "properties": {
        "kind": {
          "const": "xlsx_cell"
        },
        "page": {
          "type": "null"
        },
        "page_to": {
          "type": "null"
        },
        "section": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "structural_element": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "sheet": {
          "$ref": "#/$defs/nonBlankString"
        },
        "cell_range": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*(?::[A-Za-z]{1,3}[1-9][0-9]*)?$"
        }
      }
    },
    "metadataLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "page_to",
        "section",
        "structural_element",
        "sheet",
        "cell_range"
      ],
      "properties": {
        "kind": {
          "const": "metadata"
        },
        "page": {
          "type": "null"
        },
        "page_to": {
          "type": "null"
        },
        "section": {
          "$ref": "#/$defs/nonBlankString"
        },
        "structural_element": {
          "$ref": "#/$defs/nullableNonBlankString"
        },
        "sheet": {
          "type": "null"
        },
        "cell_range": {
          "type": "null"
        }
      }
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/pageLocation"
        },
        {
          "$ref": "#/$defs/docxOoxmlLocation"
        },
        {
          "$ref": "#/$defs/xlsxCellLocation"
        },
        {
          "$ref": "#/$defs/metadataLocation"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "location",
        "quote_mode",
        "quote",
        "fragments"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "quote_mode": {
          "type": "string",
          "enum": [
            "exact",
            "ordered_fragments"
          ]
        },
        "quote": {
          "$ref": "#/$defs/nonBlankString"
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quote_mode": {
                "const": "exact"
              }
            }
          },
          "then": {
            "properties": {
              "fragments": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "quote_mode": {
                "const": "ordered_fragments"
              }
            }
          },
          "then": {
            "properties": {
              "fragments": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "material",
        "resolution_status"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonBlankString"
        },
        "material": {
          "type": "boolean"
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_index",
        "field_key",
        "status",
        "value_text",
        "claim_basis",
        "evidence",
        "conflicts",
        "rationale"
      ],
      "properties": {
        "field_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 27
        },
        "field_key": {
          "$ref": "#/$defs/fieldKey"
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "requires_review",
            "not_found"
          ]
        },
        "value_text": {
          "$ref": "#/$defs/nullableString"
        },
        "claim_basis": {
          "type": "string",
          "enum": [
            "explicit_positive",
            "explicit_negative",
            "selected_control",
            "aggregated_explicit",
            "absence_only",
            "unresolved_conflict"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        },
        "rationale": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "value_text": {
                "$ref": "#/$defs/nonBlankString"
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "value_text": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitatech.local/schemas/tender-agent-result-v1.schema.json",
  "title": "Tender agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_catalog_version",
    "field_catalog_sha256",
    "input_manifest_sha256",
    "inspected_documents",
    "limitations",
    "constraints",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "tender_agent_result_v1"
    },
    "field_catalog_version": {
      "type": "string",
      "const": "tender_fields_v1"
    },
    "field_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inspected_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inspectedDocument"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "fieldKey": {
      "type": "string",
      "enum": [
        "procurement_subject",
        "nm_price_with_vat",
        "platform",
        "procedure_type",
        "application_deadline",
        "application_review_date",
        "results_date",
        "customer",
        "customer_contacts",
        "participation_cost",
        "participation_guarantee",
        "evaluation_criteria",
        "delivery_term",
        "payment_terms",
        "special_account_or_treasury",
        "bank_support",
        "government_contract",
        "rebidding",
        "national_regime",
        "advance_contract_guarantee",
        "warranty_obligations_guarantee",
        "licenses_certificates",
        "required_official_certificates",
        "similar_supply_experience",
        "analog_allowed",
        "analog_definition",
        "application_documents"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "resolved",
        "requires_review",
        "not_found"
      ]
    },
    "inspectedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "inspected_parts",
        "methods",
        "notes"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "inspected_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "locator",
        "quote"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "locator": {
          "$ref": "#/$defs/nonBlankString"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      }
    },
    "field": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field_index",
            "field_key",
            "status",
            "value_text",
            "evidence",
            "rationale"
          ],
          "properties": {
            "field_index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 27
            },
            "field_key": {
              "$ref": "#/$defs/fieldKey"
            },
            "status": {
              "type": "string",
              "enum": [
                "resolved",
                "requires_review"
              ]
            },
            "value_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence"
              }
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field_index",
            "field_key",
            "status",
            "value_text",
            "evidence",
            "rationale"
          ],
          "properties": {
            "field_index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 27
            },
            "field_key": {
              "$ref": "#/$defs/fieldKey"
            },
            "status": {
              "type": "string",
              "const": "not_found"
            },
            "value_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              }
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
